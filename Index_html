
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tic Tac Toe</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app">
    <h1>Tic Tac Toe</h1>
    <div class="status" id="status">X's turn</div>

    <div class="score">
      <div>X: <span id="scoreX">0</span></div>
      <div>O: <span id="scoreO">0</span></div>
      <div>Ties: <span id="scoreTie">0</span></div>
    </div>

    <div class="board" id="board"></div>

    <div class="controls">
      <button id="resetBtn">New Round</button>
      <button id="resetScoreBtn">Reset Scores</button>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>